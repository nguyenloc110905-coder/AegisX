# Development-only defaults. Copy to .env and replace values outside local use.
AEGISX_ENV=development
LOG_LEVEL=INFO

POSTGRES_DB=aegisx
POSTGRES_USER=aegisx
POSTGRES_PASSWORD=aegisx_dev_only
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+asyncpg://aegisx:aegisx_dev_only@localhost:5432/aegisx
AEGISX_EMIT_PROCESS_RESOURCE_USAGE=false
AEGISX_EMIT_NETWORK_SNAPSHOT_OBSERVATIONS=false
